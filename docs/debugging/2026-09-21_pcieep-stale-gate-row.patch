 printf 'runguard\tsim\tRUN\t-\t-\t-\t-\n' >> "$PLAN"
 
 # ---------------------------------------------------------------------------
+# THE PCIEEP-STALENESS ROW (2026-09-21, TRACK CBGUARD, defect PCIEEP-STALE).
+# ---------------------------------------------------------------------------
+# hw/fk33/gen_pcieep.py emits TWO committed files -- hw/fk33/build_fk33_pcieep.tcl
+# and hw/fk33/fk33_pcieep.xdc -- and its `--check` mode already regenerates both
+# under the environment recorded in their own GENSTAMP and compares the bytes.
+# MEASURED 2026-09-21: nothing in this script ran it.  That is the same shape
+# CLAUDE.md records for the three util_pkg.vhd copies "regenerated by a script
+# nothing schedules", and it is the shape that let compose4_top.vhd sit stale
+# since 11bf64b until an unrelated run happened to regenerate it.
+#
+# This row runs no Vivado and no GHDL: it is one python process that writes two
+# files into a tempfile.mkdtemp and diffs them.  It does NOT touch the repo
+# copies -- `--check` passes `--emit-to` to a temporary directory for exactly
+# that reason.
+#
+# WHAT IT CATCHES that sim:runguard does not.  runguard runs `--selftest`,
+# which grades the GENERATOR against its own properties; this grades the
+# COMMITTED OUTPUT against the generator.  A generator edit that changes the
+# emitted text and is not accompanied by a regenerate is invisible to
+# --selftest and red here.  MEASURED on this very change: the guard's own
+# commit rewrote 22 lines of build_fk33_pcieep.tcl and --selftest stayed green
+# throughout.
+printf 'pcieep\tsim\tRUN\t-\t-\t-\t-\n' >> "$PLAN"
+
