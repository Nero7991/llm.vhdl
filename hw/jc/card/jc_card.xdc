# hw/jc/card/jc_card.xdc -- GENERATED by hw/jc/card/gen_jc_card.py.
# DO NOT HAND-EDIT; edit the generator.
#
# Pins and the board clock, every directive of hw/jc/loader/jc_loader.xdc copied in
# order (the Jungle Cat pinout proven on silicon by the loader): sysclk on
# BC26/BC27, the fan on G9 and LED_A..D.  The TCK, CDC and clk_core constraints are
# NOT here; as for the loader they belong in the build's timing Tcl, applied to the
# opened synthesized design where a query that matches nothing stops the build.

set_property PACKAGE_PIN BC26 [get_ports sysclk_clk_p]
set_property PACKAGE_PIN BC27 [get_ports sysclk_clk_n]
set_property IOSTANDARD LVDS [get_ports sysclk_clk_p]
set_property IOSTANDARD LVDS [get_ports sysclk_clk_n]
set_property DIFF_TERM_ADV TERM_100 [get_ports sysclk_clk_p]
set_property DQS_BIAS TRUE [get_ports sysclk_clk_p]
create_clock -name sysclk -period 5.000 [get_ports sysclk_clk_p]
set_property PACKAGE_PIN G9  [get_ports fan_ctl]
set_property PACKAGE_PIN K10 [get_ports LED_A]
set_property PACKAGE_PIN K9  [get_ports LED_B]
set_property PACKAGE_PIN J9  [get_ports LED_C]
set_property PACKAGE_PIN J10 [get_ports LED_D]
set_property IOSTANDARD LVCMOS18 [get_ports {fan_ctl LED_A LED_B LED_C LED_D}]
set_false_path -to [get_ports {fan_ctl LED_A LED_B LED_C LED_D}]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]

# the Aurora core's nominal refclk (plan 2026-11-04 Task 7; Task 5 ruling): MGTREFCLK0 of
# quad X0Y0, AK38/AK39, the only refclk the IP offers for lane X0Y0. UNDRIVEN on the
# Jungle Cat board: with JC_LINK_REFCLK=gtg the ECO (hw/jc/link/eco_aurora_gtg.tcl) moves
# the running QPLL to GTGREFCLK, and this pin only gives the IBUFDS_GTE4 a legal site.
set_property PACKAGE_PIN AK38 [get_ports gt_refclk_clk_p]
create_clock -name gt_refclk -period 6.400 [get_ports gt_refclk_clk_p]
# the GTG MMCM (hw/jc/link/rtl/jc_gtg_clk.vhd, cell gtgclk/inst/u_mmcm in the BD): IBERT G
# needed an explicit site and a dedicated route for the BUFG -> MMCM net (finding 3).
# The BACKBONE property goes on the NET (IBERT G's form; on the pin it reads back on the
# pin but not on the net, Task 5 eco_check). build_card.tcl reads both back.
set_property LOC MMCM_X0Y2 [get_cells -hier -filter {NAME =~ *gtgclk/*u_mmcm}]
set_property CLOCK_DEDICATED_ROUTE BACKBONE [get_nets -of_objects [get_pins -hier -filter {NAME =~ *gtgclk/*u_mmcm/CLKIN1}]]

