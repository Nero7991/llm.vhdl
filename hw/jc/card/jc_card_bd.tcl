  if {[llength [get_bd_intf_pins -quiet ctl/$i]] != 1} {
    error "JCCARD_BD FAIL: no inferred interface ctl/$i (gen_jc_card.py CTL table)"
  }
}
# TWO clock-like pins (aclk and the BSCAN tck) can defeat ASSOCIATED_BUSIF inference,
# which defaults every interface to 100 MHz (the FK33 engine's BD 41-237 trap).  Set
# it only if inference did not (setting it where it is read-only is BD 41-737).
set _ab [get_property CONFIG.ASSOCIATED_BUSIF [get_bd_pins ctl/aclk]]
if {[lsearch -exact [split $_ab :] m_axil] < 0 || [lsearch -exact [split $_ab :] m_axi] < 0} {
  set_property CONFIG.ASSOCIATED_BUSIF {m_axil:m_axi} [get_bd_pins ctl/aclk]
  set _ab [get_property CONFIG.ASSOCIATED_BUSIF [get_bd_pins ctl/aclk]]
}
foreach i {m_axil m_axi} {
  if {[lsearch -exact [split $_ab :] $i] < 0} {
    error "JCCARD_BD FAIL: ctl/aclk ASSOCIATED_BUSIF is \"$_ab\", $i missing"
  }
}
puts "JCCARD_BD ctl/aclk ASSOCIATED_BUSIF $_ab"
connect_bd_net [get_bd_pins clk_wiz_0/clk_out3] [get_bd_pins ctl/aclk]
