# puts "FK33_TOP [get_property top [current_fileset]]"
FK33_TOP bd_wrapper
# set fk33_strategy "Performance_RefinePlacement"
# if {[info exists ::env(FK33_IMPL_STRATEGY)] && $::env(FK33_IMPL_STRATEGY) ne ""} {
