+    -- At the card both hold with equality (48 and 32), which is the design
+    -- point rather than slack.
+    if CB_RANKS > ROWS_IF then return -1; end if;
+    if CB_COPIES / CB_RANKS > BLK then return -1; end if;
+    return 0;
+  end function;
+  constant CHK_CB_RANKS : natural := cb_rank_chk_f;
